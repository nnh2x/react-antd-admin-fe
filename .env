# Backend API prefix
VITE_API_BASE_URL = "/api"

# Default route to redirect to after login
VITE_BASE_HOME_PATH = "/home"

# Website title
VITE_GLOB_APP_TITLE = "React Antd Admin"

# Prefix used for Zustand persisted storage keys, to avoid naming conflicts when multiple projects share the same origin.
VITE_APP_NAMESPACE=react-antd-admin
